<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnQueueClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_queue_circle_button"
            android:contentDescription="Cerrar cola"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cola de reproducción"
                android:textColor="@color/text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 canciones"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQueueSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_queue_circle_button"
            android:contentDescription="Buscar en la cola"
            android:padding="9dp"
            android:src="@drawable/ic_search" />

        <TextView
            android:id="@+id/btnQueueSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_queue_action"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="Guardar"
            android:textColor="@color/spotify_green"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- BUSCAR EN LA COLA (oculta por defecto)                     -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/llQueueSearchBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/etQueueSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar en la cola"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_light"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- SONANDO AHORA                                              -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_queue_now_playing"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/ivQueueCurrentArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_button_circle"
                android:contentDescription="Carátula actual"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_music_note"
                android:tint="@color/spotify_gray" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SONANDO AHORA"
                android:textColor="@color/purple_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Canción actual"
                android:textColor="@color/text_primary_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artista"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSheetPlayPause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_queue_play_button"
            android:contentDescription="Reproducir o pausar"
            android:padding="9dp"
            android:src="@drawable/ic_play_small"
            android:tint="@color/spotify_black" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- PROGRESO                                                    -->
    <!-- ========================================================= -->

    <ProgressBar
        android:id="@+id/pbSheetProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_style" />

    <!-- ========================================================= -->
    <!-- A CONTINUACION                                             -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A continuación"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLocateCurrent"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_queue_circle_button"
            android:contentDescription="Ir a la canción actual"
            android:padding="9dp"
            android:src="@drawable/ic_crosshair" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- LISTA                                                       -->
    <!-- ========================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <!-- ========================================================= -->
    <!-- MODOS DE REPRODUCCION                                      -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnModeNormal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Reproducción normal"
            android:padding="13dp"
            android:src="@drawable/ic_repeat" />

        <ImageButton
            android:id="@+id/btnModeRepeat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Repetir canción"
            android:padding="13dp"
            android:src="@drawable/ic_repeat_one" />

        <ImageButton
            android:id="@+id/btnModeShuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Aleatorio"
            android:padding="13dp"
            android:src="@drawable/ic_shuffle" />

    </LinearLayout>

</LinearLayout>