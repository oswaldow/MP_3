<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvSleepTimer5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="5 minutos"
        android:textColor="@color/text_primary_light"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSleepTimer15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="15 minutos"
        android:textColor="@color/text_primary_light"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSleepTimer30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="30 minutos"
        android:textColor="@color/text_primary_light"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSleepTimer60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="60 minutos"
        android:textColor="@color/text_primary_light"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSleepTimerEndOfSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="Al terminar la cancion"
        android:textColor="@color/text_primary_light"
        android:textSize="14sp" />

    <!-- Solo visible si ya hay un timer activo (se controla desde
         PlayerPanelController.showSleepTimerMenu()). Separado del resto
         con un divisor delgado, mismo trato visual que una accion
         destructiva/secundaria. -->
    <View
        android:id="@+id/dividerSleepTimerCancel"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF" />

    <TextView
        android:id="@+id/tvSleepTimerCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="14dp"
        android:text="Cancelar temporizador"
        android:textColor="@color/spotify_gray"
        android:textSize="14sp" />

</LinearLayout>