<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".SongListActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootSongListLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            android:text="MP_3"
            android:textColor="@color/text_primary_light"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSearch"
            app:layout_constraintBottom_toBottomOf="@id/btnSettings" />

        <LinearLayout
            android:id="@+id/llInlineSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSearch">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar cancion o artista"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary_light"
                android:textColorHint="@color/text_secondary_light"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Buscar"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSort" />

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Ordenar"
            android:padding="9dp"
            android:src="@drawable/ic_sort"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSettings" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Configuracion"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/topBarBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvAppName,llInlineSearch" />

        <LinearLayout
            android:id="@+id/llTabSelector"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_tab_container"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/topBarBarrier"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tabSongs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Canciones"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Playlists"
                android:textColor="@color/text_secondary_light"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No se encontraron canciones"
            android:textColor="@color/text_secondary_light"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSongs"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layout_constraintTop_toBottomOf="@id/llTabSelector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/llTabSelector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/playerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mini_player_full"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_skipCollapsed="false"
        app:behavior_peekHeight="90dp">

        <!-- ===================== PLAYER EXPANDIDO (estilo Spotify) ===================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/groupExpanded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/btnPanelBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                android:contentDescription="Cerrar reproductor"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_down"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/ivPanelAlbumArt"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_album_art"
                android:contentDescription="Caratula del album"
                android:elevation="12dp"
                android:padding="52dp"
                android:src="@drawable/ic_music_note"
                android:tint="@color/spotify_gray"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/btnPanelBack"
                app:layout_constraintBottom_toTopOf="@id/llPanelTitleRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.05"
                app:layout_constraintWidth_max="240dp" />

            <LinearLayout
                android:id="@+id/llPanelTitleRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/ivPanelAlbumArt"
                app:layout_constraintBottom_toTopOf="@id/sbPanelProgress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPanelSongTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cancion actual"
                        android:textColor="@color/text_primary_light"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPanelArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Artista"
                        android:textColor="@color/spotify_gray"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnPanelFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Agregar a favoritos"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorite_border" />

            </LinearLayout>

            <com.learnlayout.mp_3.WaveformSeekBar
                android:id="@+id/sbPanelProgress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/llPanelTitleRow"
                app:layout_constraintBottom_toTopOf="@id/llPanelTimeRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/llPanelTimeRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/sbPanelProgress"
                app:layout_constraintBottom_toTopOf="@id/llPanelControls"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvPanelCurrentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="00:00"
                    android:textColor="@color/spotify_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPanelTotalTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="@color/spotify_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPanelControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/llPanelTimeRow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btnMiniPlayMode"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Modo de reproduccion"
                    android:padding="10dp"
                    android:src="@drawable/ic_repeat" />

                <ImageButton
                    android:id="@+id/btnPanelPrevious"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Anterior"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/btnPanelPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_play_expanded"
                    android:contentDescription="Reproducir o pausar"
                    android:padding="20dp"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/spotify_black" />

                <ImageButton
                    android:id="@+id/btnPanelNext"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Siguiente"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_next" />

                <ImageButton
                    android:id="@+id/btnPanelQueue"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Ver cola"
                    android:padding="10dp"
                    android:src="@drawable/ic_queue_music" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===================== PANEL DE LETRA DESLIZABLE (estilo Spotify) =====================
             Ocupa, en reposo, solo el espacio libre debajo de llPanelControls (peekHeight se
             calcula en tiempo de ejecucion). Deslizando hacia arriba se expande, pero se detiene
             antes de llegar a la barra de estado (ver expandedOffset en SongListActivity). -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/lyricsCoordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/lyricsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_lyrics_panel_border"
                android:clickable="true"
                android:focusable="true"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                app:behavior_hideable="false"
                app:behavior_skipCollapsed="false"
                app:behavior_peekHeight="96dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLyricsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="18dp"
                    android:paddingBottom="32dp" />

                <View
                    android:id="@+id/dragHandleLyrics"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_drag_handle_small" />

                <ImageButton
                    android:id="@+id/btnPanelLyricsSync"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Sincronizar letra manualmente"
                    android:padding="8dp"
                    android:src="@drawable/ic_lyrics"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnSaveLyrics"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Guardar letra"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorite_border"
                    android:visibility="gone" />

            </FrameLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- ===================== MINI PLAYER (estilo Spotify) ===================== -->
        <LinearLayout
            android:id="@+id/groupMini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <ProgressBar
                android:id="@+id/pbMiniLine"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_mini_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/ivMiniAlbumArt"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_album_art_small"
                    android:contentDescription="Caratula del album"
                    android:padding="12dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/spotify_gray" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cancion actual"
                        android:textColor="@color/text_primary_light"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Artista"
                        android:textColor="@color/spotify_gray"
                        android:textSize="12sp" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.learnlayout.mp_3.CircularProgressView
                        android:id="@+id/circularMiniProgress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageButton
                        android:id="@+id/btnMiniPlayPause"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:contentDescription="Reproducir o pausar"
                        android:padding="5dp"
                        android:src="@drawable/ic_play_small" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>