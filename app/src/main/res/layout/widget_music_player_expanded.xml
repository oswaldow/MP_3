<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout EXPANDIDO del widget: se usa cuando el usuario agranda el
    widget en el launcher hasta pasar EXPANDED_MIN_HEIGHT_DP (ver
    MusicWidgetProvider.isExpandedLayout). Tarjeta vertical con
    caratula grande, titulo/artista, barra de progreso y una fila de
    controles (modo de reproduccion, anterior, play/pause, siguiente).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootExp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widgetArtContainerExp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_widget_album_art_expanded">

            <ImageView
                android:id="@+id/widgetArtPlaceholderExp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp"
                android:src="@drawable/ic_music_note"
                android:tint="@color/spotify_gray"
                android:contentDescription="@string/app_name" />

            <!-- Se muestra en lugar del placeholder en cuanto MusicWidgetProvider
                 consigue la caratula real (via AlbumArtRepository); ya llega
                 recortada con esquinas redondeadas desde el codigo, porque
                 RemoteViews no soporta clipToOutline como el resto de la app. -->
            <ImageView
                android:id="@+id/widgetAlbumArtExp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Caratula del album" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetSongTitleExp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MP_3"
                android:textColor="@color/text_primary_light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widgetSongArtistExp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abre la app para reproducir musica"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

    <!--
        style explicito Widget.ProgressBar.Horizontal (no el atributo
        de tema ?android:attr/progressBarStyleHorizontal): asi el
        ProgressBar no hereda el padding/alto extra que el tema
        Material del launcher (HyperOS/MIUI) le agrega a la version
        con tema, que era la causa de que el track se viera mucho mas
        grueso que la linea de progreso. minHeight/maxHeight fijan el
        grosor real para que ningun OEM lo estire.
    -->
    <ProgressBar
        android:id="@+id/widgetProgressExp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minHeight="6dp"
        android:maxHeight="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_widget_expanded" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widgetBtnModeExp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:src="@drawable/ic_repeat"
            android:contentDescription="Modo de reproduccion" />

        <ImageButton
            android:id="@+id/widgetBtnPreviousExp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_primary_light"
            android:contentDescription="Anterior" />

        <!--
            El boton de play/pause va dentro de una celda FrameLayout
            con el mismo weight="1" que mode/previous/next, para que
            la fila se siga repartiendo pareja entre los 4 controles
            (boton centrado, no desplazado hacia un lado). Pero el
            ImageButton de adentro tiene ancho y alto FIJOS (60x60dp):
            si en cambio el propio ImageButton fuera 0dp+weight, su
            ancho variaria segun el espacio disponible en el widget
            del usuario y el fondo ovalado se estiraria en una pildora
            horizontal en vez de verse como un circulo.
        -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center">

            <ImageButton
                android:id="@+id/widgetBtnPlayPauseExp"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_widget_play_button_expanded"
                android:scaleType="fitCenter"
                android:padding="15dp"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/white"
                android:contentDescription="Reproducir o pausar" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/widgetBtnNextExp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_primary_light"
            android:contentDescription="Siguiente" />

    </LinearLayout>

</LinearLayout>