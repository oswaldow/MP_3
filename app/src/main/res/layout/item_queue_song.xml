<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/ivQueueIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_album_art_list"
            android:clipToOutline="true"
            android:contentDescription="Carátula"
            android:padding="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            android:tint="@color/spotify_gray" />

        <ImageView
            android:id="@+id/ivQueuePlaying"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_queue_playing_badge"
            android:contentDescription="Reproduciendo"
            android:padding="4dp"
            android:src="@drawable/ic_equalizer"
            android:tint="@color/spotify_black"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvQueueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Título de la canción"
            android:textColor="@color/text_primary_light"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQueueArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Artista"
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvQueuePosition"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:text="01"
        android:textColor="@color/spotify_gray"
        android:textSize="9sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:contentDescription="Arrastrar para reordenar"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/spotify_gray" />

</LinearLayout>