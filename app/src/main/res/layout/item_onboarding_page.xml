<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="40dp">

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_onboarding_icon_circle">

        <ImageView
            android:id="@+id/ivOnboardingIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:tint="@color/white"
            android:contentDescription="@null" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textColor="@color/text_primary_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Titulo de ejemplo" />

    <TextView
        android:id="@+id/tvOnboardingDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_secondary_light"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        tools:text="Descripcion de ejemplo que explica la funcion." />

</LinearLayout>