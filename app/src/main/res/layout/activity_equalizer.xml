<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnEqBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Regresar"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Ecualizador"
            android:textColor="@color/text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEqEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/spotify_green"
            app:trackTint="@color/spotify_gray"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvEqUnavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="El ecualizador no esta disponible en este dispositivo"
        android:textColor="@color/text_secondary_light"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llEqBandsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp" />

    <TextView
        android:id="@+id/btnEqReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_item_song"
        android:gravity="center"
        android:padding="14dp"
        android:text="Restablecer"
        android:textColor="@color/text_primary_light"
        android:textStyle="bold" />

</LinearLayout>