<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLyricsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true"
    tools:context=".LyricsActivity">

    <ImageButton
        android:id="@+id/btnLyricsBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_icon_button_circle"
        android:contentDescription="Cerrar"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnLyricsSyncToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_button_circle"
        android:contentDescription="Sincronizar letra manualmente"
        android:padding="8dp"
        android:src="@drawable/ic_crosshair"
        app:layout_constraintTop_toTopOf="@id/btnLyricsBack"
        app:layout_constraintBottom_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnLyricsEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_button_circle"
        android:contentDescription="Editar o pegar letra"
        android:padding="8dp"
        android:src="@drawable/ic_edit"
        app:layout_constraintTop_toTopOf="@id/btnLyricsBack"
        app:layout_constraintBottom_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintEnd_toStartOf="@id/btnLyricsSyncToggle" />

    <TextView
        android:id="@+id/tvLyricsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary_light"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnLyricsBack"
        app:layout_constraintBottom_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintStart_toEndOf="@id/btnLyricsBack"
        app:layout_constraintEnd_toStartOf="@id/btnLyricsEdit" />

    <ProgressBar
        android:id="@+id/progressLyrics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLyricsMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:textColor="@color/text_secondary_light"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLyrics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="120dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aviso mostrado solo en modo sincronizacion manual -->
    <TextView
        android:id="@+id/tvSyncHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_box"
        android:gravity="center"
        android:padding="10dp"
        android:text="Toca la linea cuando empiece a sonar"
        android:textColor="@color/text_primary_light"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay para pegar/escribir la letra a mano antes de sincronizar -->
    <LinearLayout
        android:id="@+id/lyricsEditOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_dark"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnLyricsBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Pega o escribe la letra, una linea por renglon"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etLyricsRaw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:gravity="top|start"
            android:hint="Letra de la cancion..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_light"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnConfirmEditLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_pill_solid"
            android:gravity="center"
            android:padding="14dp"
            android:text="Usar esta letra y sincronizar"
            android:textColor="@color/spotify_black"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Barra inferior del modo de sincronizacion manual -->
    <LinearLayout
        android:id="@+id/llSyncControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_player_full"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSyncPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Reproducir o pausar"
            android:padding="10dp"
            android:src="@drawable/ic_play_small" />

        <TextView
            android:id="@+id/tvSyncProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="0/0 lineas"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSaveSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:background="@drawable/bg_btn_pill_solid"
            android:enabled="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Guardar"
            android:textColor="@color/spotify_black"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>