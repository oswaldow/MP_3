<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="64dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle"
        android:contentDescription="Cerrar reproductor"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnQueue"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_button_circle"
        android:contentDescription="Ver cola"
        android:padding="8dp"
        android:src="@drawable/ic_queue_music"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivAlbumArt"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_album_art"
        android:contentDescription="Caratula del album"
        android:padding="70dp"
        android:src="@drawable/ic_music_note"
        android:tint="@color/text_secondary_light"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/tvSongTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside" />

    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Nombre de la cancion"
        android:textColor="@color/text_primary_light"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivAlbumArt"
        app:layout_constraintBottom_toTopOf="@id/tvArtist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Artista"
        android:textColor="@color/text_secondary_light"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
        app:layout_constraintBottom_toTopOf="@id/sbProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.learnlayout.mp_3.WaveformSeekBar
        android:id="@+id/sbProgress"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="#FF0000"
        app:layout_constraintTop_toBottomOf="@id/tvArtist"
        app:layout_constraintBottom_toTopOf="@id/llControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="00:00"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/sbProgress"
        app:layout_constraintStart_toStartOf="@id/sbProgress" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="00:00"
        android:textColor="@color/text_secondary_light"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/sbProgress"
        app:layout_constraintEnd_toEndOf="@id/sbProgress" />

    <LinearLayout
        android:id="@+id/llControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/sbProgress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Anterior"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Reproducir o pausar"
            android:padding="16dp"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:contentDescription="Siguiente"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>