<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_item_song"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="70dp">

        <ImageView
            android:id="@+id/ivPlaylistCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_playlist_cover"
            android:contentDescription="Portada de playlist"
            android:padding="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_queue_music" />

        <ImageButton
            android:id="@+id/btnEditCover"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_icon_button_circle"
            android:contentDescription="Cambiar portada"
            android:padding="4dp"
            android:src="@drawable/ic_add_photo" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nombre playlist"
            android:textColor="@color/text_primary_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaylistSong1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPlaylistSong2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_secondary_light"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPlaylistCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0"
        android:textColor="@color/text_secondary_light"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/btnDeletePlaylist"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="Eliminar playlist"
        android:padding="6dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>